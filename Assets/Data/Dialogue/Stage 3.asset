MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 847f4c1c8e10cbe46a6b957043c80246, type: 3}
  m_Name: Stage 3
  m_EditorClassIdentifier: Assembly-CSharp::BeatMemories.DialogueSO
  lines:
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "...\uC18C\uB77C\uC5D0\uAC8C\uC11C \uC2E4\uB9C8\uB9AC\uB97C \uC5BB\uC5C8\uC5B4.\r\n\uB0A8\uC740
      \uAC83\uC740... \uD655\uC2E0\uC758 \uC99D\uAC70."
  - speaker: 0
    speakerName: "\uD30C\uBE14\uB77C"
    portrait: {fileID: 1717547328183112094, guid: 9e6b50e505156394c8724b50a5cc11b5, type: 3}
    text: "\uADF8\uB798\uC11C, \uC5EC\uAE30\uAE4C\uC9C0 \uAE30\uC5B4\uB4E4\uC5B4\uC628
      \uAC70\uAD6C\uB098.\r\n\uB3D9\uBCF5\uC5D0\uC11C \uD0DC\uC5B4\uB09C \uBC14\uD034\uBC8C\uB808."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -5706498570558230270, guid: 934726093db696c4ca7a7679c38c51c5, type: 3}
    text: "\uC5B8\uB2C8..."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -8021583265106815176, guid: 27b1a22c63ab88645b75544a6d1abff4, type: 3}
    text: "\uCE5C\uAD6C\uB97C, \uCC3E\uACE0 \uC2F6\uC740 \uAC83 \uBFD0\uC774\uC57C."
  - speaker: 0
    speakerName: "\uD30C\uBE14\uB77C"
    portrait: {fileID: 7698074854943918167, guid: 7ab97b09c9f8cd64883cf927e6fcba49, type: 3}
    text: "\uADF8\uAC83 \uBFD0\uC774\uB2C8?\r\n\uB3C4\uC2DC\uC758 \uC0C1\uBD80\uC5D0\uC11C
      \uC9C0\uC2DC\uBC1B\uC558\uB2E4\uB294 \uC774\uC57C\uAE30\uB294, \uC3D9 \uBE7C\uB193\uACE0?"
  - speaker: 0
    speakerName: "\uD30C\uBE14\uB77C"
    portrait: {fileID: 58699422220172323, guid: 60f7d46f511c4164b83b0eb7b3ee34b4, type: 3}
    text: "\uD30C\uBA78\uBFD0\uC778 \uB0B4\uC77C\uC744 \uB9C8\uC8FC\uD558\uAE30 \uC2EB\uC5B4,
      \uC9C0\uAE08\uC5D0\uC11C \uB208\uC744 \uB3CC\uB824\uBC84\uB9B0... \uC6B0\uB9AC
      \uAC00\uC5EC\uC6B4 \uD074\uB77C\uC6B0\uB514\uC544!"
  - speaker: 0
    speakerName: "\uD30C\uBE14\uB77C"
    portrait: {fileID: 58699422220172323, guid: 60f7d46f511c4164b83b0eb7b3ee34b4, type: 3}
    text: "\uC720\uAC10\uC2A4\uB7FD\uAC8C\uB3C4... \uADF8 \uC544\uC774\uC5D0\uAC8C
      \uBC1B\uC740 \uAC12\uC740 \uD574\uC57C \uD558\uB2C8\uAE4C. \uBB3C\uB860 \uB0B4\uAC00
      \uC544\uB2C8\uB77C \uC5B4\uBA38\uB2C8\uAC00 \uBC1B\uC740 \uAC70\uC9C0\uB9CC."
  - speaker: 0
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "...\uC5B4\uBA38\uB2C8\uAC00, \uADF8 \uC544\uC774\uB97C...!"
  - speaker: 0
    speakerName: "\uD30C\uBE14\uB77C"
    portrait: {fileID: 58699422220172323, guid: 60f7d46f511c4164b83b0eb7b3ee34b4, type: 3}
    text: "\uC790, \uBB38\uB2F5\uBB34\uC6A9\uC774\uC57C.\r\n\uC774 \uBB34\uB3C4\uD68C\uC7A5\uC744
      \uC9C0\uB098\uAC00\uB824\uBA74...\\n\uB098\uB97C \uC4F0\uB7EC\uB728\uB824\uC57C\uACA0\uC9C0?"
  - speaker: 0
    speakerName: "\uD30C\uBE14\uB77C"
    portrait: {fileID: 58699422220172323, guid: 60f7d46f511c4164b83b0eb7b3ee34b4, type: 3}
    text: "--\uBB34\uC218\uD55C \uB3D9\uD3EC\uB4E4\uC758 \uD55C\uACFC \uACE0\uD1B5\uC774
      \uD750\uB4DC\uB7EC\uC9C4... \uADF8 \uC190\uC73C\uB85C \uB9D0\uC774\uC57C? \uC6B0\uD6C4\uD6C4..."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "(....\uC815\uC2E0 \uBC14\uC9DD \uCC28\uB9AC\uC790.\n\uC5B8\uB2C8\uB294...
      \uC5C4\uCCAD\uB098\uAC8C \uBE68\uB77C!)"
