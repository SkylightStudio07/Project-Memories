--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 847f4c1c8e10cbe46a6b957043c80246, type: 3}
  m_Name: Stage 5_Phase 2
  m_EditorClassIdentifier: Assembly-CSharp::BeatMemories.DialogueSO
  lines:
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: 8969574864928723867, guid: 45e3bb3fec03277409e13d498c742e80, type: 3}
    text: "...\uAC70\uC2AC\uB9AC\uAC8C \uAD6C\uB124.\n\uBBF8\uB798 \uC608\uCE21 \uBAA8\uB4C8\uC5D0
      \uD53C\uD574\uB97C \uC785\uD600\uB3C4 \uC774 \uC815\uB3C4\uC778\uAC00..."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: 8075468258146922719, guid: 450e97ac77dd1f44bae79ad3a64a650f, type: 3}
    text: "\uC774\uC81C... \uADF8\uB9CC... \uD3EC\uAE30\uD574...!\n\uB2E4\uB97C\uB808\uC559...
      \uC774\uC81C \uADF8\uB9CC...!"
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: -534251805290457002, guid: bef4f956e7b2a2a4b995a88a9ba908eb, type: 3}
    text: "\uD3EC\uAE30... \uB3C4\uC2DC\uC5D0 \uB3CC\uC544\uAC00\uBA74, \n\uB098\uB294
      \uC5B4\uB5BB\uAC8C \uB420\uAE4C. \uD074\uB77C\uC6B0\uB514\uC544.\n\uC8FD\uACA0\uC9C0,
      \uB098\uB294."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: 8075468258146922719, guid: 450e97ac77dd1f44bae79ad3a64a650f, type: 3}
    text: "\uB0B4\uAC00, \uB0B4\uAC00 \uB2E4\uB97C\uB808\uC559\uC744 \uC9C0\uD0AC
      \uAC70\uC57C...!"
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: -534251805290457002, guid: bef4f956e7b2a2a4b995a88a9ba908eb, type: 3}
    text: "\uD5DB\uC18C\uB9AC.\n.....\uC88B\uC544. \uC2DC\uAC04\uBC8C\uC774\uB294
      \uB410\uAD70.\n\uC5D0\uACE0 \uCE74\uD0C0\uB098---\uC2DC\uB3D9."
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: 2682927425148708686, guid: 878b907f747db6c498aca87be92cd73a, type: 3}
    text: "\uC778\uACFC\uC728\uC744 \uB4A4\uD2C0\uC5B4\uBC84\uB9AC\uB294 \uBB34\uAE30\uB77C\uBA74,
      \uB124 \uBAA8\uB4C8\uB3C4 \uBB34\uC6A9\uC9C0\uBB3C\uC774\uACA0\uC9C0?"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "\uB2E4\uB97C\uB808\uC559....."
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: -7075526589965273158, guid: f2331bfac0936e149a62ee60e0ff6910, type: 3}
    text: "\uC124\uB839 \uC0DD\uC758 \uB05D\uAE4C\uC9C0 \uC774\uC6A9\uB2F9\uD55C\uB2E4\uD574\uB3C4
      \uC0C1\uAD00\uC5C6\uC5B4."
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: -534251805290457002, guid: bef4f956e7b2a2a4b995a88a9ba908eb, type: 3}
    text: "\uB098\uB294 \uC774 \uB3C4\uC2DC\uB97C \uBD88\uD0DC\uC6B8... \uC804\uC7C1\uC758
      \uAE30\uC218\uAC00 \uB418\uACA0\uB2E4."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: ".....\uADF8\uB7EC\uBA74 \uB098\uB294, \uC9C0\uD0AC \uAC70\uC57C."
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: 2682927425148708686, guid: 878b907f747db6c498aca87be92cd73a, type: 3}
    text: "\uC774 \uB9DD\uAC00\uC9C0\uACE0 \uAD6C\uC5ED\uC9C8\uB098\uB294 \uB3C4\uC2DC\uB97C?"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -5706498570558230270, guid: 934726093db696c4ca7a7679c38c51c5, type: 3}
    text: "\uC544\uB2C8.\n\uBAA8\uB450\uB97C, \uB2E4\uB97C\uB808\uC559\uC744!"
  - speaker: 0
    speakerName: "\uB2E4\uB97C\uB808\uC559"
    portrait: {fileID: -7828949313565039875, guid: f3a58cbc1101d3941a48501574c0f48e, type: 3}
    text: "\uD5DB\uC18C\uB9AC\uB294 \uC815\uB3C4\uAECF \uD574\uB77C.\n\uBCA0\uC5B4\uC8FC\uB9C8."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -8021583265106815176, guid: 27b1a22c63ab88645b75544a6d1abff4, type: 3}
    text: "(\uB9C8\uC9C0\uB9C9\uC774\uC57C...!.)"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "(\uB2E4\uB97C\uB808\uC559\uC758 \uC800 \uBB34\uAE30\uB294 \uB0B4 \uBAA8\uB4C8\uC774
      \uC798 \uBA39\uD788\uC9C0 \uC54A\uC544...)"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -5706498570558230270, guid: 934726093db696c4ca7a7679c38c51c5, type: 3}
    text: "(\uBBFF\uC744 \uAC83\uC740... \uC628\uC804\uD788, \uB098 \uC790\uC2E0!)"
