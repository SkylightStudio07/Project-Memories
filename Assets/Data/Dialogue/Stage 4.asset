  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 847f4c1c8e10cbe46a6b957043c80246, type: 3}
  m_Name: Stage 4
  m_EditorClassIdentifier: Assembly-CSharp::BeatMemories.DialogueSO
  lines:
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "\uD558\uC544... \uD558\uC544..."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "\uC5B4\uBA38\uB2C8...!"
  - speaker: 0
    speakerName: "\uC624\uD37C\uB808\uC774\uD130"
    portrait: {fileID: -2562287875293089574, guid: c34c8320de0312c4bb5bc51fb00929a7, type: 3}
    text: "--\uB098\uB294 \uB0B4 \uB808\uD50C\uB9AC\uCE74\uB97C \uD0A4\uC6E0\uC9C0,
      \uC0AC\uC774\uBCF4\uADF8\uB97C \uD0A4\uC6B4 \uC801\uC740 \uC5C6\uB2E8\uB2E4?
      \uD074\uB77C\uC6B0\uB514\uC544."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "\uC74F...! \uB410\uC5B4!\r\n\uB2E4\uB97C\uB808\uC559...! \uC544\uB2C8,
      DALL-E\uB294, \uC5B4\uB514\uC5D0 \uC788\uC5B4!!"
  - speaker: 0
    speakerName: "\uC624\uD37C\uB808\uC774\uD130"
    portrait: {fileID: -7109546529610065317, guid: a541a66456d93a84eaca43fc16dd2ccf, type: 3}
    text: "\uAE00\uC384? \uC9C0\uAE08\uCBE4, \uB0B4\uAC00 \uBCF5\uC81C\uD55C \uCE74\uB4DC\uD0A4\uB97C
      \uBC1B\uACE0 \uB3C4\uC2DC\uC758 \uC678\uACFD\uAE4C\uC9C0 \uAC00\uC9C0 \uC54A\uC558\uC73C\uB824\uB098?"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "\uB300\uCCB4, \uC65C \uADF8\uB7F0 \uC9D3\uC744...!!\n\uC5B4\uBA38\uB2C8\uB294,
      \uC6B0\uB9AC\uC640 \uB2EC\uB9AC--"
  - speaker: 0
    speakerName: "\uC624\uD37C\uB808\uC774\uD130"
    portrait: {fileID: -7818924898305715283, guid: 10dcd6bebeaf0bc449c298f2e8bea02d, type: 3}
    text: "\uC778\uAC04\uC774\uC9C0. \uB108\uD76C\uCC98\uB7FC \uBC18\uC774 \uAE30\uACC4\uAC00
      \uC544\uB2C8\uACE0. \n\uB2E8\uC9C0 \uD30C\uC6CC\uB4DC \uC288\uD2B8\uB97C \uC785\uC5C8\uC744
      \uBFD0\uC778."
  - speaker: 0
    speakerName: "\uC624\uD37C\uB808\uC774\uD130"
    portrait: {fileID: -7109546529610065317, guid: a541a66456d93a84eaca43fc16dd2ccf, type: 3}
    text: "\uADF8\uB0E5... \uADF8\uAC83\uBFD0\uC774\uC57C?\r\n\uC7AC\uBBF8\uC788\uC5B4
      \uBCF4\uC774\uC796\uC544? \uADF8 \uC544\uC774\uAC00 \uC5B4\uB514\uAE4C\uC9C0
      \uAC08\uC9C0\uB97C."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "...\uB2E8\uC9C0 \uC7AC\uBBF8\uC788\uC5B4 \uBCF4\uC778\uB2E4\uACE0, \uADF8
      \uC544\uC774\uB97C \uC0AC\uC9C0\uC5D0..."
  - speaker: 0
    speakerName: "\uC624\uD37C\uB808\uC774\uD130"
    portrait: {fileID: -7818924898305715283, guid: 10dcd6bebeaf0bc449c298f2e8bea02d, type: 3}
    text: "\uCEAC\uCEAC\uCEAC, \uC774\uC0C1\uD55C \uC774\uC57C\uAE30\uB97C \uD558\uB294\uAD6C\uB098?
      \uD074\uB77C\uC6B0\uB514\uC544.\n\uC0C1\uBD80\uAC00 \uADF8 \uC544\uC774\uB97C
      \uC6A9\uC11C\uD560\uB9AC\uAC00."
  - speaker: 0
    speakerName: "\uC624\uD37C\uB808\uC774\uD130"
    portrait: {fileID: -7818924898305715283, guid: 10dcd6bebeaf0bc449c298f2e8bea02d, type: 3}
    text: "\uADF8\uB7EC\uB2C8\uAE4C... \r\n\uC5B4\uC11C \uB098\uB97C \uC4F0\uB7EC\uB728\uB9AC\uACE0,
      \uC774 \uAD34\uAE30\uD55C \uD76C\uADF9\uC758 \uB05D\uC744 \uBCF4\uC5EC\uC8FC\uB834!"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "(......\uD06D! \uBBF8\uB798 \uC608\uCE21 \uBAA8\uB4C8\uC5D0 \uC5C4\uCCAD\uB09C
      \uC7AC\uBC0D \uC2DC\uB3C4\uAC00...! \uC774\uB798\uC120, \uBBF8\uB798 \uC608\uCE21\uC5D0
      \uC870\uAE08\uC529 \uBB38\uC81C\uAC00 \uC0DD\uAE38 \uAC70\uC57C...!)"
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "(\uADF8\uAC83\uC744 \uAC10\uC548\uD574\uB3C4 \uC5B4\uBA38\uB2C8\uB294
      \uAC15\uC790!\\n......\uC5B8\uB2C8\uC640, \uCC28\uC6D0\uC774 \uB2E4\uB97C \uD14C\uB2C8\uAE4C.)"
