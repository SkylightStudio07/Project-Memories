  m_EditorClassIdentifier: Assembly-CSharp::BeatMemories.DialogueSO
  lines:
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -6071435802697707932, guid: d06bf404d4d79a74fa5c41cdc0c9bf3b, type: 3}
    text: "A.T.L.A.S. \uBB34\uAE30\uB97C \uBC84\uB9AC\uACE0 \uD22C\uD56D\uD574."
  - speaker: 0
    speakerName: A.T.L.A.S
    portrait: {fileID: 5752741710423377366, guid: ad91b89292c8edf4e8bc7ecb4ceaa306, type: 3}
    text: "\uADF8\uB9AC\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \\n\uC870\uBB3C\uC8FC\uC778
      \uC778\uB958\uC758 \uACA9\uC5B8\uC744 \uC778\uC6A9\uD558\uC790\uBA74 '\uD574\uC57C
      \uD560 \uC77C\uC774 \uC788\uB2E4'\uB77C\uB294 \uAC83\uC774\uACA0\uC8E0. "
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -5706498570558230270, guid: 934726093db696c4ca7a7679c38c51c5, type: 3}
    text: ".....\uADF8\uB807\uB2E4\uBA74, \uC81C\uC555\uD560 \uC218\uBC16\uC5D0."
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -8021583265106815176, guid: 27b1a22c63ab88645b75544a6d1abff4, type: 3}
    text: "(\uC88C\uCE21 \uD654\uC0B4\uD45C\uB85C \uC544\uD2C0\uB77C\uC2A4\uC758
      \uACF5\uACA9\uC744 \uBC29\uC5B4.\\n\n\uC6B0\uCE21 \uD654\uC0B4\uD45C\uB85C
      \uC544\uD2C0\uB77C\uC2A4\uB97C \uACF5\uACA9\uD560 \uC218 \uC788\uC5B4.) "
  - speaker: 1
    speakerName: "\uD074\uB77C\uC6B0\uB514\uC544"
    portrait: {fileID: -8021583265106815176, guid: 27b1a22c63ab88645b75544a6d1abff4, type: 3}
    text: "(\uADF8\uB9AC\uACE0 \uB098\uB294... \uBBF8\uB798 \uC608\uCE21 \uBAA8\uB4C8\uB85C
      A.T.L.A.S\uC758 \uD589\uB3D9\uC744 \uC804\uBD80 \uC608\uACAC\uD574\uB0BC \uC218
      \uC788\uC73C\uB2C8\uAE4C. \uC5B4\uB824\uC6B4 \uC2F8\uC6C0\uC740 \uC544\uB2D0
      \uAC70\uC57C.)"
